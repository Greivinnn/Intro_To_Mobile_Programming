<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d0d0f">

    <!-- ── TOP HUD ─────────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/hudLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1a1a22"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- HP -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tvHp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20 / 20"
                android:textColor="#e8e0d0"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textStyle="bold"/>
            <ProgressBar
                android:id="@+id/hpBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="100"
                android:progressTint="#e74c3c"
                android:progressBackgroundTint="#2a2a35"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HP"
                android:textColor="#888888"
                android:textSize="10sp"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- ATK -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tvAtk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚔️ 4"
                android:textColor="#e8e0d0"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ATK"
                android:textColor="#888888"
                android:textSize="10sp"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- POTIONS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tvPotions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧪 2"
                android:textColor="#e8e0d0"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POTIONS"
                android:textColor="#888888"
                android:textSize="10sp"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- SCORE -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tvScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#e8e0d0"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCORE"
                android:textColor="#888888"
                android:textSize="10sp"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- FLOOR -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tvFloor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="#f39c12"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FLOOR"
                android:textColor="#888888"
                android:textSize="10sp"
                android:fontFamily="monospace"/>
        </LinearLayout>

    </LinearLayout>

    <!-- ── DUNGEON VIEW ────────────────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/gameViewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/hudLayout"
        app:layout_constraintBottom_toTopOf="@id/logText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ── COMBAT LOG ──────────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/logText"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#111118"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="#c9bfff"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:gravity="bottom"
        android:text="You descend into the dungeon..."
        app:layout_constraintBottom_toTopOf="@id/controlsLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ── CONTROLS ───────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/controlsLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:background="#0d0d0f"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- D-PAD -->
        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="3">

            <Space android:layout_width="56dp" android:layout_height="56dp"/>
            <Button
                android:id="@+id/btnUp"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="▲"
                android:textSize="20sp"
                android:backgroundTint="#1e1e2e"
                android:textColor="#c9bfff"
                android:padding="0dp"/>
            <Space android:layout_width="56dp" android:layout_height="56dp"/>

            <Button
                android:id="@+id/btnLeft"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="◀"
                android:textSize="20sp"
                android:backgroundTint="#1e1e2e"
                android:textColor="#c9bfff"
                android:padding="0dp"/>
            <Space android:layout_width="56dp" android:layout_height="56dp"/>
            <Button
                android:id="@+id/btnRight"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="▶"
                android:textSize="20sp"
                android:backgroundTint="#1e1e2e"
                android:textColor="#c9bfff"
                android:padding="0dp"/>

            <Space android:layout_width="56dp" android:layout_height="56dp"/>
            <Button
                android:id="@+id/btnDown"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="▼"
                android:textSize="20sp"
                android:backgroundTint="#1e1e2e"
                android:textColor="#c9bfff"
                android:padding="0dp"/>
            <Space android:layout_width="56dp" android:layout_height="56dp"/>

        </GridLayout>

        <!-- SPACER -->
        <Space android:layout_width="24dp" android:layout_height="wrap_content"/>

        <!-- POTION BUTTON -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <Button
                android:id="@+id/btnPotion"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:text="🧪"
                android:textSize="24sp"
                android:backgroundTint="#2a1f4e"
                android:padding="0dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POTION"
                android:textColor="#555555"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
